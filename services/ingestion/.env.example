SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
KEEPALIVE_SECRET=
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_DRIVE_API_KEY=
# Limite por arquivo enviado ou baixado, em MB. Vale tambem para o arquivo extraido de um .zip/.gz.
# Fontes grandes (ex.: CSVs de saude e energia de 250-400 MB) pedem ~600; o arquivo inteiro fica em memoria.
MAX_SOURCE_MB=200
# Memoria usada para guardar arquivos entre a leitura e a importacao, em MB
SOURCE_CACHE_MB=1024
